{
  "name": "snread-brave-extension",
  "version": "1.6.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "SnRead smart Arabic and English reading assistant for Brave and Chromium browsers.",
  "scripts": {
    "check": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test",
    "package": "bash scripts/package-extension.sh",
    "harness": "node scripts/serve.mjs",
    "qa:browser": "node tests/playwright/site-manager.spec.mjs && node tests/playwright/popup-save.spec.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
